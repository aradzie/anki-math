!type: Basic Math (and reversed card)

!id: aHB662tV62
!front: \[ 1 + 2 + \ldots + n \]
!back: \[ \frac{n(n + 1)}{2} \]
!related:
\[
\begin{align*}
    1 + 2 + \ldots + n &= \frac{n(n+1)}{2} \\
    1^2 + 2^2 + \ldots + n^2 &= \frac{n(n+1)(2n+1)}{6} \\
    1^3 + 2^3 + \ldots + n^3 &= \left( \frac{n(n+1)}{2} \right)^2 = \frac{n^2(n+1)^2}{4}
\end{align*}
\]
~~~

