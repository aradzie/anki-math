!id: NZYddeTg9i
!front: \[ \mathscr{L} \{ 1 \} \]
!back: \[ \frac{1}{s} \]
!related:
\[
\begin{align*}
\mathscr{L} \{ 1 \} &= \frac{1}{s} \\
\mathscr{L} \{ t^n \} &= \frac{n!}{s^{n+1}}
\end{align*}
\]
~~~

!id: 3KRahvnI04
!front: \[ \mathscr{L} \{ t^n \}, \, n = 1, 2, 3, \ldots \]
!back: \[ \frac{n!}{s^{n+1}} \]
!related:
\[
\begin{align*}
\mathscr{L} \{ 1 \} &= \frac{1}{s} \\
\mathscr{L} \{ t^n \} &= \frac{n!}{s^{n+1}}
\end{align*}
\]
~~~

!id: LNfz4L5hou
!front: \[ \mathscr{L} \{ \sin(at) \} \]
!back: \[ \frac{a}{s^2 + a^2} \]
!related:
\[
\begin{align*}
\mathscr{L} \{ \sin(at) \} &= \frac{a}{s^2 + a^2} \\
\mathscr{L} \{ \cos(at) \} &= \frac{s}{s^2 + a^2} \\
\mathscr{L} \{ \sinh(at) \} &= \frac{a}{s^2 - a^2} \\
\mathscr{L} \{ \cosh(at) \} &= \frac{s}{s^2 - a^2}
\end{align*}
\]
~~~

!id: tN7TTdycA6
!front: \[ \mathscr{L} \{ \cos(at) \} \]
!back: \[ \frac{s}{s^2 + a^2} \]
!related:
\[
\begin{align*}
\mathscr{L} \{ \sin(at) \} &= \frac{a}{s^2 + a^2} \\
\mathscr{L} \{ \cos(at) \} &= \frac{s}{s^2 + a^2} \\
\mathscr{L} \{ \sinh(at) \} &= \frac{a}{s^2 - a^2} \\
\mathscr{L} \{ \cosh(at) \} &= \frac{s}{s^2 - a^2}
\end{align*}
\]
~~~

!id: McDbGiS3cb
!front: \[ \mathscr{L} \{ \sin(at + b) \} \]
!back: \[ \frac{s \sin(b) + a \cos(b)}{s^2 + a^2} \]
!related:
\[
\begin{align*}
\mathscr{L} \{ \sin(at + b) \} &= \frac{s \sin(b) + a \cos(b)}{s^2 + a^2} \\
\mathscr{L} \{ \cos(at + b) \} &= \frac{s \cos(b) - a \sin(b)}{s^2 + a^2}
\end{align*}
\]
~~~

