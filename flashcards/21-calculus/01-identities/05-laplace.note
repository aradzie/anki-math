!id: glAQ8aaVKP
!front: \[ \mathscr{L} \{ e^{ct} f(t) \} \]
!back: \[ F(s - c) \]
~~~

!id: APrkyWHpY9
!front: \[ \mathscr{L} \{ e^{ct} \} \]
!back: \[ \frac{1}{s - c} \]
!related: \[ \mathscr{L} \{ e^{ct} f(t) \} = F(s - c) \]
~~~

!id: EhODildxyc
!front: \[ \mathscr{L} \{ e^{ct} t^n \}, \, n = 1, 2, 3, \ldots \]
!back: \[ \frac{n!}{(s - c)^{n + 1}} \]
!related: \[ \mathscr{L} \{ e^{ct} f(t) \} = F(s - c) \]
~~~

!id: h2YfE3Kcfk
!front: \[ \mathscr{L} \{ e^{ct} \sin(at) \} \]
!back: \[ \frac{a}{(s - c)^2 + a^2} \]
!related:
\[
\newcommand{\eqrow}{\vphantom{\frac{s-c}{(s-c)^2-a^2}}}
\begin{align*}
\eqrow\mathscr{L}\{e^{ct}f(t)\} &= F(s-c) \\
\eqrow\mathscr{L}\{e^{ct}\sin(at)\} &= \frac{a}{(s-c)^2+a^2} \\
\eqrow\mathscr{L}\{e^{ct}\cos(at)\} &= \frac{s-c}{(s-c)^2+a^2} \\
\eqrow\mathscr{L}\{e^{ct}\sinh(at)\} &= \frac{a}{(s-c)^2-a^2} \\
\eqrow\mathscr{L}\{e^{ct}\cosh(at)\} &= \frac{s-c}{(s-c)^2-a^2}
\end{align*}
\]
~~~

