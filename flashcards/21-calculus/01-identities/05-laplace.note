!id: gqdLJbeebN
!front: \[ \mathscr{L} \{ \delta (t - c) \}, \quad c \ge 0 \]
!back: \[ e^{-cs} \]
!related:
\[
\begin{align*}
\mathscr{L} \{ \delta (t - c) \} &= e^{-cs} \\
\mathscr{L} \{ u(t - c) \} &= e^{-cs} \frac{1}{s}
\end{align*}
\]
~~~

!id: y3ZWYAOBIR
!front: \[ \mathscr{L} \{ u(t - c) \}, \quad c \ge 0 \]
!back: \[ e^{-cs} \frac{1}{s} \]
!related:
\[
\begin{align*}
\mathscr{L} \{ \delta (t - c) \} &= e^{-cs} \\
\mathscr{L} \{ u(t - c) \} &= e^{-cs} \frac{1}{s}
\end{align*}
\]
~~~

!id: jFPp0XWKuj
!front: \[ \mathscr{L} \{ u(t - c) f(t - c) \}, \quad c \ge 0 \]
!back: \[ e^{-cs} F(s) \]
!related:
\[
\begin{align*}
\mathscr{L} \{ u(t - c) f(t - c) \} &= e^{-cs} F(s) \\
\mathscr{L} \{ u(t - c) f(t) \} &= e^{-cs} \mathscr{L} \{ f(t + c) \}
\end{align*}
\]
~~~

!id: jwx7yTQrI0
!front: \[ \mathscr{L} \{ u(t - c) f(t) \}, \quad c \ge 0 \]
!back: \[ e^{-cs} \mathscr{L} \{ f(t + c) \} \]
!related:
\[
\begin{align*}
\mathscr{L} \{ u(t - c) f(t - c) \} &= e^{-cs} F(s) \\
\mathscr{L} \{ u(t - c) f(t) \} &= e^{-cs} \mathscr{L} \{ f(t + c) \}
\end{align*}
\]
~~~

!id: DBrCzTevVh
!front: \[ \mathscr{L} \left\{ \frac{f(t)}{t} \right\} \]
!back: \[ \int_{s}^{\infty} F(u) \, du \]
!related:
\[
\begin{align*}
\mathscr{L} \left\{ \frac{f(t)}{t} \right\} &= \int_{s}^{\infty} F(u) \, du \\
\frac{F(s)}{s} &= \mathscr{L} \left\{ \int_{0}^{t} f(u) \, du \right\}
\end{align*}
\]
~~~

!id: h4Kgni8vFp
!front: \[ \mathscr{L} \left\{ \int_{0}^{t} f(u) \, du \right\} \]
!back: \[ \frac{F(s)}{s} \]
!related:
\[
\begin{align*}
\mathscr{L} \left\{ \frac{f(t)}{t} \right\} &= \int_{s}^{\infty} F(u) \, du \\
\frac{F(s)}{s} &= \mathscr{L} \left\{ \int_{0}^{t} f(u) \, du \right\}
\end{align*}
\]
~~~

!id: f1zJutGe2P
!front: \[ \mathscr{L} \{ f'(t) \} \]
!back: \[ s F(s) - f(0) \]
!related:
\[
\begin{align*}
\mathscr{L} \{ f'(t) \} &= s F(s) - f(0) \\
\mathscr{L} \{ f''(t) \} &= s^2 F(s) - s f(0) - f'(0)
\end{align*}
\]
~~~

!id: jTbt1RuKOo
!front: \[ \mathscr{L} \{ f''(t) \} \]
!back: \[ s^2 F(s) - s f(0) - f'(0) \]
!related:
\[
\begin{align*}
\mathscr{L} \{ f'(t) \} &= s F(s) - f(0) \\
\mathscr{L} \{ f''(t) \} &= s^2 F(s) - s f(0) - f'(0)
\end{align*}
\]
~~~
