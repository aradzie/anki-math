\]
~~~

!tags: Math Calculus Derivative Trigonometric Identity

!id: dZo3n2deUD
!front: \[ \frac{d}{dx} \sin x \]
!back: \[ \cos x \]
!related:
\[
\begin{align*}
\frac{d}{dx} \sin x &= \cos x \\
\frac{d}{dx} \cos x &= - \sin x \\
\frac{d}{dx} \sinh x &= \cosh x \\
\frac{d}{dx} \cosh x &= \sinh x
\end{align*}
\]
~~~

!id: h8KflmsUb1
!front: \[ \frac{d}{dx} \cos x \]
!back: \[ - \sin x \]
!related:
\[
\begin{align*}
\frac{d}{dx} \sin x &= \cos x \\
\frac{d}{dx} \cos x &= - \sin x \\
\frac{d}{dx} \sinh x &= \cosh x \\
\frac{d}{dx} \cosh x &= \sinh x
\end{align*}
\]
~~~

!id: RVHZz1YzI7
!front: \[ \frac{d}{dx} \tan x \]
!back: \[ \sec^2 x \]
!related:
\[
\begin{align*}
\frac{d}{dx} \tan x &= \sec^2 x \\
\frac{d}{dx} \cot x &= - \csc^2 x \\
\frac{d}{dx} \tanh x &= \operatorname{sech}^2 x \\
\frac{d}{dx} \coth x &= - \operatorname{csch}^2 x
\end{align*}
\]
~~~

!id: kE2cgA67q5
!front: \[ \frac{d}{dx} \cot x \]
!back: \[ - \csc^2 x \]
!related:
\[
\begin{align*}
\frac{d}{dx} \tan x &= \sec^2 x \\
\frac{d}{dx} \cot x &= - \csc^2 x \\
\frac{d}{dx} \tanh x &= \operatorname{sech}^2 x \\
\frac{d}{dx} \coth x &= - \operatorname{csch}^2 x
\end{align*}
\]
~~~

!id: pbIiBpzIAX
!front: \[ \frac{d}{dx} \sec x \]
!back: \[ \sec x \tan x \]
!related:
\[
\begin{align*}
\frac{d}{dx} \sec x &= \sec x \tan x \\
\frac{d}{dx} \csc x &= - \csc x \cot x \\
\frac{d}{dx} \operatorname{sech} x &= - \operatorname{sech} x \tanh x \\
\frac{d}{dx} \operatorname{csch} x &= - \operatorname{csch} x \coth x
\end{align*}
\]
~~~

!id: pr9EizVbVP
!front: \[ \frac{d}{dx} \csc x \]
!back: \[ - \csc x \cot x \]
!related:
\[
\begin{align*}
\frac{d}{dx} \sec x &= \sec x \tan x \\
\frac{d}{dx} \csc x &= - \csc x \cot x \\
\frac{d}{dx} \operatorname{sech} x &= - \operatorname{sech} x \tanh x \\
\frac{d}{dx} \operatorname{csch} x &= - \operatorname{csch} x \coth x
\end{align*}
\]
~~~

!id: 9F87TrKW4O
!front: \[ \frac{d}{dx} \sin^{-1} x \]
!back: \[ \frac{1}{\sqrt{1 - x^2}} \]
!related:
\[
\begin{align*}
\frac{d}{dx} \sin^{-1} x &= \frac{1}{\sqrt{1 - x^2}} \\
\frac{d}{dx} \cos^{-1} x &= \frac{-1}{\sqrt{1 - x^2}} \\
\frac{d}{dx} \sinh^{-1} x &= \frac{1}{\sqrt{x^2 + 1}} \\
\frac{d}{dx} \cosh^{-1} x &= \frac{1}{\sqrt{x^2 - 1}}
\end{align*}
\]
~~~

!id: 6inbyeofyZ
!front: \[ \frac{d}{dx} \cos^{-1} x \]
!back: \[ \frac{-1}{\sqrt{1 - x^2}} \]
!related:
\[
\begin{align*}
\frac{d}{dx} \sin^{-1} x &= \frac{1}{\sqrt{1 - x^2}} \\
\frac{d}{dx} \cos^{-1} x &= \frac{-1}{\sqrt{1 - x^2}} \\
\frac{d}{dx} \sinh^{-1} x &= \frac{1}{\sqrt{x^2 + 1}} \\
\frac{d}{dx} \cosh^{-1} x &= \frac{1}{\sqrt{x^2 - 1}}
\end{align*}
\]
~~~

!id: vecrIpdDYu
!front: \[ \frac{d}{dx} \tan^{-1} x \]
!back: \[ \frac{1}{1 + x^2} \]
!related:
\[
\begin{align*}
\frac{d}{dx} \tan^{-1} x &= \frac{1}{1 + x^2} \\
\frac{d}{dx} \cot^{-1} x &= \frac{-1}{1 + x^2} \\
\frac{d}{dx} \tanh^{-1} x &= \frac{1}{1 - x^2}, \quad |x| < 1 \\
\frac{d}{dx} \coth^{-1} x &= \frac{1}{1 - x^2}, \quad |x| > 1
\end{align*}
\]
~~~

!id: rbADQeQewZ
!front: \[ \frac{d}{dx} \cot^{-1} x \]
!back: \[ \frac{-1}{1 + x^2} \]
!related:
\[
\begin{align*}
\frac{d}{dx} \tan^{-1} x &= \frac{1}{1 + x^2} \\
\frac{d}{dx} \cot^{-1} x &= \frac{-1}{1 + x^2} \\
\frac{d}{dx} \tanh^{-1} x &= \frac{1}{1 - x^2}, \quad |x| < 1 \\
\frac{d}{dx} \coth^{-1} x &= \frac{1}{1 - x^2}, \quad |x| > 1
\end{align*}
\]
~~~

!id: ayh94WrgD3
!front: \[ \frac{d}{dx} \sec^{-1} x \]
!back: \[ \frac{1}{|x| \sqrt{x^2 - 1}} \]
!related:
\[
\begin{align*}
\frac{d}{dx} \sec^{-1} x &= \frac{1}{|x| \sqrt{x^2 - 1}} \\
\frac{d}{dx} \csc^{-1} x &= \frac{-1}{|x| \sqrt{x^2 - 1}} \\
\frac{d}{dx} \operatorname{sech}^{-1} x &= \frac{-1}{x \sqrt{1 - x^2}} \\
\frac{d}{dx} \operatorname{csch}^{-1} x &= \frac{-1}{|x| \sqrt{1 + x^2}}
\end{align*}
\]
~~~

!id: dGRb1nRKhO
!front: \[ \frac{d}{dx} \csc^{-1} x \]
!back: \[ \frac{-1}{|x| \sqrt{x^2 - 1}} \]
!related:
\[
\begin{align*}
\frac{d}{dx} \sec^{-1} x &= \frac{1}{|x| \sqrt{x^2 - 1}} \\
\frac{d}{dx} \csc^{-1} x &= \frac{-1}{|x| \sqrt{x^2 - 1}} \\
\frac{d}{dx} \operatorname{sech}^{-1} x &= \frac{-1}{x \sqrt{1 - x^2}} \\
\frac{d}{dx} \operatorname{csch}^{-1} x &= \frac{-1}{|x| \sqrt{1 + x^2}}
\end{align*}
\]
~~~

