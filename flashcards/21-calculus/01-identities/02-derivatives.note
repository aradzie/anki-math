!id: q0ytSwY5qI
!front: \[ \frac{d}{dx} e^x \]
!back: \[ e^x \]
!related:
\[
\begin{align*}
\frac{d}{dx} e^x &= e^x \\
\frac{d}{dx} a^x &= a^x \ln a
\end{align*}
\]
~~~

