!related:
\[
\begin{align*}
\frac{d}{dx} e^x &= e^x \\
\frac{d}{dx} a^x &= a^x \ln a
\end{align*}
\]
~~~

!id: 6znjaekIg8
!front: \[ \frac{d}{dx} \ln x \]
!back: \[ \frac{1}{x} \]
!related:
\[
\begin{align*}
\frac{d}{dx} \ln x &= \frac{1}{x} \\
\frac{d}{dx} \log_b x &= \frac{1}{x \ln b}
\end{align*}
\]
~~~

