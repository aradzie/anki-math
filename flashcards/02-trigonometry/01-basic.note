\tan (2 \theta) &= \dfrac{2 \tan \theta}{1 - \tan^2 \theta} = \frac{2}{\cot \theta - \tan \theta}
\end{align*}
\]
~~~

!id: wB2mTXY2QO
!front: \[ \sin^2 \theta \]
!back: \[ \frac{1 - \cos (2 \theta)}{2} \]
!related:
\[
\begin{align*}
\sin^2 \theta &= \frac{1 - \cos (2 \theta)}{2} \\
\cos^2 \theta &= \frac{1 + \cos (2 \theta)}{2} \\
\tan^2 \theta &= \frac{1 - \cos (2 \theta)}{1 + \cos (2 \theta)}
\end{align*}
\]
~~~

!id: dPXtwF6cC0
!front: \[ \cos^2 \theta \]
!back: \[ \frac{1 + \cos (2 \theta)}{2} \]
!related:
\[
\begin{align*}
\sin^2 \theta &= \frac{1 - \cos (2 \theta)}{2} \\
\cos^2 \theta &= \frac{1 + \cos (2 \theta)}{2} \\
\tan^2 \theta &= \frac{1 - \cos (2 \theta)}{1 + \cos (2 \theta)}
\end{align*}
\]
~~~

