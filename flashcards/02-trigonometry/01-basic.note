!id: oOiCl13qR2
!front: \[ \tan (\alpha + \beta) \]
!back: \[ \frac{\tan \alpha + \tan \beta}{1 - \tan \alpha \tan \beta} \]
!related:
\[
\begin{align*}
\tan (\alpha + \beta) &= \frac{\tan \alpha + \tan \beta}{1 - \tan \alpha \tan \beta} \\
\tan (\alpha - \beta) &= \frac{\tan \alpha - \tan \beta}{1 + \tan \alpha \tan \beta}
\end{align*}
\]
~~~

!id: 91hZj24jjD
!front: \[ \tan (\alpha - \beta) \]
!back: \[ \frac{\tan \alpha - \tan \beta}{1 + \tan \alpha \tan \beta} \]
!related:
\[
\begin{align*}
\tan (\alpha + \beta) &= \frac{\tan \alpha + \tan \beta}{1 - \tan \alpha \tan \beta} \\
\tan (\alpha - \beta) &= \frac{\tan \alpha - \tan \beta}{1 + \tan \alpha \tan \beta}
\end{align*}
\]
~~~

!id: t9KssxdSSc
!front: \[ \sin (2 \theta) \]
!back: \[ 2 \sin \theta \cos \theta \]
!related:
\[
\begin{align*}
\sin (2 \theta) &= 2 \sin \theta \cos \theta \\[8pt]
\cos (2 \theta) &= \cos^2 \theta - \sin^2 \theta = 1 - 2 \sin^2 \theta = 2 \cos^2 \theta - 1 \\[4pt]
\tan (2 \theta) &= \dfrac{2 \tan \theta}{1 - \tan^2 \theta} = \frac{2}{\cot \theta - \tan \theta}
\end{align*}
\]
~~~

!id: aeqXcKvao0
!front: \[ \cos (2 \theta) \]
!back:
\[ \cos^2 \theta - \sin^2 \theta \]
\[ 1 - 2 \sin^2 \theta \]
\[ 2 \cos^2 \theta - 1 \]
!related:
\[
\begin{align*}
\sin (2 \theta) &= 2 \sin \theta \cos \theta \\[8pt]
\cos (2 \theta) &= \cos^2 \theta - \sin^2 \theta = 1 - 2 \sin^2 \theta = 2 \cos^2 \theta - 1 \\[4pt]
\tan (2 \theta) &= \dfrac{2 \tan \theta}{1 - \tan^2 \theta} = \frac{2}{\cot \theta - \tan \theta}
\end{align*}
\]
~~~

!id: 7WYmjBDTz0
!front: \[ \tan (2 \theta) \]
