!id: lZ0zhm8g36
!front: \[ \int u^n \, du \]
!back: \[ \frac{u^{n + 1}}{n + 1} + C, \quad n \neq -1 \]
~~~

!id: CNxuUVeyZe
!front: \[ \int \frac{1}{u} \, du \]
!back: \[ \ln |u| + C \]
~~~

!id: pS8ujWDEb3
!front: \[ \int e^u \, du \]
!back: \[ e^u + C \]
!related:
\[
\begin{align*}
\int e^u \, du &= e^u + C \\
\int a^u \, du &= \frac{a^u}{\ln a} + C
\end{align*}
\]
~~~

!id: jOafeMIzmf
!front: \[ \int a^u \, du \]
!back: \[ \frac{a^u}{\ln a} + C \]
!related:
\[
\begin{align*}
\int e^u \, du &= e^u + C \\
\int a^u \, du &= \frac{a^u}{\ln a} + C
\end{align*}
\]
~~~

!tags: Math Calculus Integral Trigonometric Identity

!id: xe7Mcs0OX6
!front: \[ \int \sin u \, du \]
!back: \[ - \cos u + C \]
!related:
\[
\begin{align*}
\int \sin u \, du &= -\cos u + C \\
\int \cos u \, du &= \sin u + C \\
\int \sinh u \, du &= \cosh u + C \\
\int \cosh u \, du &= \sinh u + C
\end{align*}
\]
~~~

!id: 3WR4Fy7CWN
!front: \[ \int \cos u \, du \]
!back: \[ \sin u + C \]
!related:
\[
\begin{align*}
\int \sin u \, du &= -\cos u + C \\
\int \cos u \, du &= \sin u + C \\
\int \sinh u \, du &= \cosh u + C \\
\int \cosh u \, du &= \sinh u + C
\end{align*}
\]
~~~

!id: ocy5ICfIBc
!front: \[ \int \sec^2 u \, du \]
!back: \[ \tan u + C \]
!related:
\[
\begin{align*}
\int \sec^2 u \, du &= \tan u + C \\
\int \csc^2 u \, du &= -\cot u + C \\
\int \operatorname{sech}^2 u \, du &= \tanh u + C \\
\int \operatorname{csch}^2 u \, du &= -\coth u + C
\end{align*}
\]
~~~

!id: LNq5eNNcxo
!front: \[ \int \csc^2 u \, du \]
!back: \[ - \cot u + C \]
!related:
\[
\begin{align*}
\int \sec^2 u \, du &= \tan u + C \\
\int \csc^2 u \, du &= -\cot u + C \\
\int \operatorname{sech}^2 u \, du &= \tanh u + C \\
\int \operatorname{csch}^2 u \, du &= -\coth u + C
\end{align*}
\]
~~~

!id: Yi52b6if5q
!front: \[ \int \sec u \tan u \, du \]
!back: \[ \sec u + C \]
!related:
\[
\begin{align*}
\int \sec u \tan u \, du &= \sec u + C \\
\int \csc u \cot u \, du &= -\csc u + C \\
\int \operatorname{sech} u \tanh u \, du &= -\operatorname{sech} u + C \\
\int \operatorname{csch} u \coth u \, du &= -\operatorname{csch} u + C
\end{align*}
\]
~~~

!id: gVLYWQbUbr
!front: \[ \int \csc u \cot u \, du \]
!back: \[ - \csc u + C \]
!related:
\[
\begin{align*}
\int \sec u \tan u \, du &= \sec u + C \\
\int \csc u \cot u \, du &= -\csc u + C \\
\int \operatorname{sech} u \tanh u \, du &= -\operatorname{sech} u + C \\
\int \operatorname{csch} u \coth u \, du &= -\operatorname{csch} u + C
\end{align*}
\]
~~~

!id: UUghDrZyX1
!front: \[ \int \tan u \, du \]
!back:
\[ - \ln | \cos u | + C \]
\[ \ln | \sec u | + C \]
!related:
\[
\begin{align*}
\int \tan u \, du &= -\ln | \cos u | + C = \ln | \sec u | + C \\
\int \cot u \, du &= \ln | \sin u | + C = -\ln | \csc u | + C
\end{align*}
\]
~~~

!id: aPxGEA8HVR
!front: \[ \int \cot u \, du \]
!back:
\[ \ln | \sin u | + C \]
\[ - \ln | \csc u | + C \]
!related:
\[
\begin{align*}
\int \tan u \, du &= -\ln | \cos u | + C = \ln | \sec u | + C \\
\int \cot u \, du &= \ln | \sin u | + C = -\ln | \csc u | + C
\end{align*}
\]
~~~

!id: ZTHiGvJS4h
!front: \[ \int \sec u \, du \]
!back: \[ \ln | \sec u + \tan u | + C \]
!related:
\[
\begin{align*}
\int \sec u \, du &= \ln | \sec u + \tan u | + C \\
\int \csc u \, du &= \ln | \csc u - \cot u | + C
\end{align*}
\]
~~~

!id: 3qgJWFwghl
!front: \[ \int \csc u \, du \]
!back: \[ \ln | \csc u - \cot u | + C \]
!related:
\[
\begin{align*}
\int \sec u \, du &= \ln | \sec u + \tan u | + C \\
\int \csc u \, du &= \ln | \csc u - \cot u | + C
\end{align*}
\]
~~~

!id: 9JIJDq67WB
!front: \[ \int \frac{1}{\sqrt{a^2 - u^2}} \, du \]
!back: \[ \sin^{-1} \frac{u}{a} + C \]
~~~

!id: L9Vk6BIjci
!front: \[ \int \frac{1}{a^2 + u^2} \, du \]
!back: \[ \frac{1}{a} \tan^{-1} \frac{u}{a} + C \]
~~~

!id: DcuQJwYLyv
!front: \[ \int \frac{1}{u \sqrt{u^2 - a^2}} \, du \]
!back: \[ \frac{1}{a} \sec^{-1} \frac{u}{a} + C \]
~~~

!tags: Math Calculus Integral Hyperbolic Identity

